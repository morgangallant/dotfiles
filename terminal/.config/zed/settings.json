{
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "edit_predictions": {
    "provider": "copilot",
    "copilot": {
      "prediction_debounce": 0
    }
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "base_keymap": "VSCode",
  "cli_default_open_behavior": "new_window",

  "ui_font_family": "Berkeley Mono",
  "ui_font_size": 14.0,
  "buffer_font_family": "Berkeley Mono",
  "buffer_font_size": 13.0,
  "buffer_line_height": { "custom": 1.3 },

  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "scroll_beyond_last_line": "off",
  "cursor_blink": false,
  "current_line_highlight": "gutter",
  "restore_on_startup": "last_session",
  "confirm_quit": false,
  "autosave": "off",

  "telemetry": { "diagnostics": false, "metrics": false },
  "show_edit_predictions": true,
  "agent": { "enabled": false, "button": false },
  "inlay_hints": {
    "enabled": false,
    "toggle_on_modifiers_press": { "control": true }
  },

  "minimap": { "show": "never" },
  "scrollbar": { "show": "never" },
  "indent_guides": { "enabled": false },
  "inline_code_actions": false,
  "gutter": {
    "line_numbers": true,
    "runnables": false,
    "breakpoints": false,
    "folds": false,
    "min_line_number_digits": 3
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": true,
    "show_close_button": "hidden"
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_branch_status_icon": false
  },
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": true
  },

  "project_panel": {
    "button": false,
    "dock": "left",
    "entry_spacing": "standard",
    "auto_reveal_entries": false,
    "file_icons": false,
    "indent_guides": { "show": "never" }
  },
  "outline_panel": { "button": false },
  "git_panel": { "button": false },
  "collaboration_panel": { "button": false },
  "debugger": { "button": false },
  "terminal": {
    "dock": "right",
    "button": false,
    "blinking": "off",
    "line_height": "standard"
  },

  "languages": {
    "Rust": {
      "format_on_save": "on",
      "preferred_line_length": 100
    }
  },

  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "rust": { "analyzerTargetDir": true },
        "check": { "command": "check", "workspace": false },
        "cargo": { "allTargets": false }
      }
    }
  }
}
